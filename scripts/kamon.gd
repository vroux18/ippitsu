static var _meshes := {}  # id -> ArrayMesh (null : tracé inconnu)
static var _loops := {}  # id -> contours fermés (bords lissés)
static var _re: RegEx


## Dessine le kamon « id » centré en c, à l'échelle sc (1 = repère de la maquette), dans la couleur col. Le bord
## (contours d'origine, lissés) adoucit l'escalier des triangles : il n'existe pas d'anticrénelage 2D dans le projet.
static func draw(ci: CanvasItem, id: String, c: Vector2, sc: float, col: Color, rot := 0.0) -> void:
	var m: ArrayMesh = mesh(id)
	if m == null:
		return
	ci.draw_set_transform(c, rot, Vector2(sc, sc))
	ci.draw_mesh(m, null, Transform2D.IDENTITY, col)
	var px := absf(ci.get_global_transform_with_canvas().get_scale().x) * sc
	if px > 0.0:
		for lp in _loops[id]:
			ci.draw_polyline(lp, col, 0.7 / px, true)
	ci.draw_set_transform_matrix(Transform2D.IDENTITY)


static func mesh(id: String) -> ArrayMesh:
	if _meshes.has(id):
		return _meshes[id]
	var m: ArrayMesh = null
	var loops: Array = []
	if PATHS.has(id):
		for sp in parse(String(PATHS[id])):
			var lp: PackedVector2Array = sp.duplicate()
			lp.append(lp[0])
			loops.append(lp)
		var tris := triangles(String(PATHS[id]))
		if tris.size() >= 3:
			var arr := []
			arr.resize(Mesh.ARRAY_MAX)
			arr[Mesh.ARRAY_VERTEX] = tris
			m = ArrayMesh.new()
			m.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arr)
	_meshes[id] = m
	_loops[id] = loops
	return m


## Sous-chemins (polylignes fermées) d'un tracé M/L/Z.
static func parse(d: String) -> Array:
	if _re == null:
		_re = RegEx.new()
		_re.compile("[MLZmlz]|-?[0-9]*\\.?[0-9]+(?:[eE][-+]?[0-9]+)?")
	var subs: Array = []
	var cur := PackedVector2Array()
	var nums: Array = []
	for r in _re.search_all(d):
		var t := r.get_string()
		if t == "M" or t == "m":
			if cur.size() >= 3:
				subs.append(cur)
			cur = PackedVector2Array()
		elif t == "Z" or t == "z":
			if cur.size() >= 3:
				subs.append(cur)
			cur = PackedVector2Array()
		elif t == "L" or t == "l":
			pass
		else:
			nums.append(float(t))
			if nums.size() == 2:
				cur.append(Vector2(nums[0], nums[1]))
				nums.clear()
	if cur.size() >= 3:
		subs.append(cur)
	return subs


## Aire signée (repère de l'écran, y vers le bas) : > 0 pour une forme, < 0 pour un trou (gen.py).
static func area(p: PackedVector2Array) -> float:
	var s := 0.0
	for i in p.size():
		var a := p[i]
		var b := p[(i + 1) % p.size()]
		s += a.x * b.y - b.x * a.y
	return s * 0.5


## Triangles (liste plate, trois sommets par triangle) du remplissage d'un tracé.
static func triangles(d: String) -> PackedVector2Array:
	var fills: Array = []
	var holes: Array = []
	for p in parse(d):
		var sp: PackedVector2Array = p
		if area(sp) >= 0.0:
			fills.append(sp)
		else:
			var hp := sp.duplicate()
			hp.reverse()
			holes.append(hp)
	# chaque trou annule une seule forme (nonzero) : la plus petite qui le contient (maillon d'une chaîne, bol…)
	var owner := []
	for h in holes:
		var hp: PackedVector2Array = h
		var best := -1
		var best_a := INF
		for i in fills.size():
			var fp: PackedVector2Array = fills[i]
			var a := area(fp)
			if a < best_a and Geometry2D.is_point_in_polygon(_inner_point(hp), fp):
				best = i
				best_a = a
		owner.append(best)
	var pieces: Array = []
	for i in fills.size():
		var cur: Array = [fills[i]]
		for j in holes.size():
			if int(owner[j]) == i or int(owner[j]) < 0:  # trou à cheval sur plusieurs formes : retiré de toutes
				cur = _cut(cur, holes[j])
		pieces.append_array(cur)
	var out := PackedVector2Array()
	for pc in pieces:
		var poly: PackedVector2Array = pc
		var idx := Geometry2D.triangulate_polygon(poly)
		if idx.is_empty():
			# repli : morceaux convexes, en éventail
			for cv in Geometry2D.decompose_polygon_in_convex(poly):
				var q: PackedVector2Array = cv
				for i in range(1, q.size() - 1):
					out.append(q[0])
					out.append(q[i])
					out.append(q[i + 1])
			continue
		for i in idx:
			out.append(poly[i])
	return out


## Retranche le trou h de chaque morceau ; un trou enclos coupe d'abord le morceau en deux à son milieu.
static func _cut(pieces: Array, h: PackedVector2Array) -> Array:
	var hb := _bounds(h)
	var out: Array = []
	for pc in pieces:
		var p: PackedVector2Array = pc
		if not _bounds(p).intersects(hb):
			out.append(p)
			continue
		var res: Array = Geometry2D.clip_polygons(p, h)
		if not _has_hole(res):
			out.append_array(res)
			continue
		var cx := hb.get_center().x
		var big := 1000.0
		var halves := [
			PackedVector2Array([Vector2(-big, -big), Vector2(cx, -big), Vector2(cx, big), Vector2(-big, big)]),
			PackedVector2Array([Vector2(cx, -big), Vector2(big, -big), Vector2(big, big), Vector2(cx, big)]),
		]
		for half in halves:
			for part in Geometry2D.intersect_polygons(p, half):
				var r2: Array = Geometry2D.clip_polygons(part, h)
				if _has_hole(r2):
					out.append(part)  # ne devrait pas arriver : on garde la forme pleine
				else:
					out.append_array(r2)
	return out


## Un point du trou (le milieu de deux sommets opposés s'il tombe dedans, sinon un sommet).
static func _inner_point(h: PackedVector2Array) -> Vector2:
	var m := (h[0] + h[h.size() / 2]) * 0.5
	if Geometry2D.is_point_in_polygon(m, h):
		return m
	var c := Vector2.ZERO
	for v in h:
		c += v
	c /= float(h.size())
	return c if Geometry2D.is_point_in_polygon(c, h) else h[0]


static func _has_hole(res: Array) -> bool:
	if res.size() < 2:
		return false
	var cw0 := Geometry2D.is_polygon_clockwise(res[0])
	for r in res:
		if Geometry2D.is_polygon_clockwise(r) != cw0:
			return true
	return false


static func _bounds(p: PackedVector2Array) -> Rect2:
	var r := Rect2(p[0], Vector2.ZERO)
	for v in p:
		r = r.expand(v)
	return r
